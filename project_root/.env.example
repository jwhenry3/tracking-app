# Docker Compose environment
# Copy to .env in this directory before: docker compose up --build
#
# MySQL runs on a remote host — not as a Docker service.
# Use the same DB_* values for local dev in backend/.env.
#
# Local frontend env: frontend/.env.example → frontend/.env

# App (ports 80/443 reserved for legacy app — this stack uses APP_PORT)
APP_PORT=8080
APP_ORIGIN=http://localhost:8080

# Remote MySQL
DB_HOST=your.mysql.host
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=tracking_app
LEGACY_DB_NAME=bill_dashboard_dev

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# Password recovery (optional). Reset links use APP_ORIGIN.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
