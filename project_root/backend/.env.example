# Backend environment (local development)
# Copy to backend/.env
#
# MySQL runs on a remote host — use the same DB_* values in project_root/.env for Docker Compose.

# Remote MySQL
DB_HOST=your.mysql.host
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=tracking_app
LEGACY_DB_NAME=bill_dashboard_dev

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# Password recovery email (optional). Without SMTP, reset requests return 503.
# APP_ORIGIN is used in reset links. Defaults to CORS_ORIGIN if unset.
APP_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server
PORT=8080
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
