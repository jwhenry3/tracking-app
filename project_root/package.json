{
  "name": "fullstack-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && air",
    "dev:backend:go": "cd backend && go run .",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "build:backend": "cd backend && go build -o server.exe .",
    "seed:db": "cd backend && go run ./cmd/seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
